EXPLORER_SESSION_SECRET_KEY=""
# L'email à utiliser pour récupérer une license Home.
INFLUXDB3_LICENSE_EMAIL=
INFLUXDB3_LICENSE_TYPE=home
# DEV : "VOTRE_IP:9094" ou PROD : "IP_DU_SERVEUR_OPEN_FACTORY:9094"
KAFKA_BROKER=
# Le token à utiliser pour se connecter à InfluxDB3. Il est généré par le serveur InfluxDB3.
# Commande a exécuter pour générer le token : docker exec -it openfactory-influxdb-influxdb3-enterprise-1 influxdb3 create token --admin
INFLUXDB3_TOKEN=""
SQL_DB_CONN="DRIVER={ODBC Driver 17 for SQL Server};SERVER=IP_SERVEUR_SQLSRV;DATABASE=labusine_db;UID=USER;PWD=PASSWORD"
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=password